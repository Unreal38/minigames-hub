[Unit]
Description=Zatoka Gier minigames server
After=network.target

[Service]
Type=simple
User=cozy
WorkingDirectory=/opt/cozy-table
Environment=PORT=8080
Environment=HOST=127.0.0.1
# accounts, stats and open lobbies are saved here (systemd creates /var/lib/cozy-table for the cozy user)
StateDirectory=cozy-table
Environment=DATA_DIR=/var/lib/cozy-table
# Hosts: usernames (comma separated) who can moderate the hub chat and see who is online.
#Environment=ADMINS=yourusername
# Screens online at once before newcomers wait in line (default 3000; one core carries about 3,000-4,000).
#Environment=MAX_ONLINE=3000
# The privacy page (/privacy): where people write about their data, and where the server stands.
#Environment=PRIVACY_CONTACT=you@example.com
#Environment="SERVER_PLACE=Oracle Cloud, Frankfurt (Germany)"
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=2
# light hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
