[Unit]
Description=Cozy Table minigames server
After=network.target

[Service]
Type=simple
User=cozy
WorkingDirectory=/opt/cozy-table
Environment=PORT=8080
Environment=HOST=127.0.0.1
# accounts, stats and open lobbies are saved here (systemd creates /var/lib/cozy-table for the cozy user)
StateDirectory=cozy-table
Environment=DATA_DIR=/var/lib/cozy-table
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=2
# light hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
