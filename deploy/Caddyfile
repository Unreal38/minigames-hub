# Replace example.com with your domain. Caddy gets and renews the HTTPS certificate by itself.
example.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8080
	# Access logs (IP, time, page, browser) are kept 14 days, as the privacy page (/privacy) promises. Caddy only rolls
	# a log at 100 MB, which a small site may take months to reach, so logrotate rolls it daily instead (README, Privacy page).
	log {
		output file /var/log/caddy/access.log {
			roll_disabled
		}
	}
}

# www sends people (and Google) to the one main address, so search results never split between two copies.
www.example.com {
	redir https://example.com{uri} permanent
}
